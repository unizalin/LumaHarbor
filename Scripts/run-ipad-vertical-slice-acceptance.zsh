        fi
    done
    if (( all_pass )); then
        print -r -- "selftest: fake successful run -> all five steps show PASS: ok"
    else
        print -r -- "selftest: fake successful run -> not every step shows PASS"
        case_failures=$((case_failures + 1))
    fi

    (( case_failures == 0 ))
}

